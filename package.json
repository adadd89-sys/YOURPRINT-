{
  "name": "yourprint",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot and Mini App for DTF printing orders",
  "workspaces": [
    "apps/bot",
    "apps/web"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace @yourprint/bot",
    "dev:web": "npm run dev --workspace @yourprint/web",
    "build:bot": "npm run build --workspace @yourprint/bot",
    "build:web": "npm run build --workspace @yourprint/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.6.1"
  }
}
