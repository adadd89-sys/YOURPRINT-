{
  "name": "yourprint",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot and Mini App for DTF printing orders",
  "workspaces": [
    "apps/bot",
    "apps/web"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace @yourprint/bot",
    "dev:web": "npm run dev --workspace @yourprint/web",
    "build:bot": "npm run build --workspace @yourprint/bot",
    "build:web": "npm run build --workspace @yourprint/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "build:web:cloudflare": "npm run build:cloudflare --workspace @yourprint/web",
    "preview:web:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:web:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.9.3",
    "wrangler": "latest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.6.1",
    "@opennextjs/cloudflare": "latest",
    "@prisma/adapter-neon": "^6.19.0",
    "@neondatabase/serverless": "^1.0.2"
  }
}
